{
  "mov": {
    "prefix": "mov",
    "body": [
      "mov ${1:r1}, ${2:0}"
    ],
    "description": "mov instruction"
  },
  "load": {
    "prefix": [
      "load",
      "lw"
    ],
    "body": [
      "${1|lw,lh,lhu,lb,lbu|} ${2:r1}, [${3:r0} + ${4:0}]"
    ],
    "description": "load from memory"
  },
  "store": {
    "prefix": [
      "store",
      "sw"
    ],
    "body": [
      "${1|sw,sh,sb|} [${2:r0} + ${3:0}], ${4:r1}"
    ],
    "description": "store to memory"
  },
  "multiply": {
    "prefix": "mul",
    "body": [
      "mul ${1:r1}, ${2:r2}, ${3:r3}"
    ],
    "description": "multiply and keep the low 32 bits"
  },
  "divide": {
    "prefix": [
      "div",
      "divu"
    ],
    "body": [
      "${1|div,divu|} ${2:r1}, ${3:r2}, ${4:r3}"
    ],
    "description": "signed or unsigned division"
  },
  "remainder": {
    "prefix": [
      "rem",
      "remu"
    ],
    "body": [
      "${1|rem,remu|} ${2:r1}, ${3:r2}, ${4:r3}"
    ],
    "description": "signed or unsigned remainder"
  },
  "jmp": {
    "prefix": "jmp",
    "body": [
      "jmp ${1:target}"
    ],
    "description": "jump to target"
  },
  "jmp link": {
    "prefix": [
      "jmplink",
      "jal"
    ],
    "body": [
      "jmp ${1:target}, ${2:r14}"
    ],
    "description": "jump to target and save PC+4"
  },
  "cmp": {
    "prefix": "cmp",
    "body": [
      "cmp ${1:r1}, ${2:r2} ${3|==,!=,<,<=,>,>=|} ${4:r3}"
    ],
    "description": "signed comparison producing 0 or 1"
  },
  "cmpu": {
    "prefix": "cmpu",
    "body": [
      "cmpu ${1:r1}, ${2:r2} ${3|==,!=,<,<=,>,>=|} ${4:r3}"
    ],
    "description": "unsigned comparison producing 0 or 1"
  },
  "bz": {
    "prefix": "bz",
    "body": [
      "bz ${1:r1}, ${2:r0} + ${3:target}"
    ],
    "description": "branch when register is zero"
  },
  "bnz": {
    "prefix": "bnz",
    "body": [
      "bnz ${1:r1}, ${2:r0} + ${3:target}"
    ],
    "description": "branch when register is nonzero"
  },
  "label": {
    "prefix": "label",
    "body": [
      "${1:label}:"
    ],
    "description": "label definition"
  },
  ".prog": {
    "prefix": [
      ".prog",
      "prog"
    ],
    "body": [
      ".prog ${1:program_name}"
    ],
    "description": "program output name"
  },
  ".entry": {
    "prefix": [
      ".entry",
      "entry"
    ],
    "body": [
      ".entry ${1:start}"
    ],
    "description": "program entry label"
  },
  ".equ": {
    "prefix": [
      ".equ",
      "equ"
    ],
    "body": [
      ".equ ${1:name} ${2:value}"
    ],
    "description": "constant macro definition"
  },
  ".equ symbol": {
    "prefix": [
      ".equdef",
      "equdef"
    ],
    "body": [
      ".equ ${1:symbol}"
    ],
    "description": "symbol-only macro definition"
  },
  ".ifdef": {
    "prefix": [
      ".ifdef",
      "ifdef"
    ],
    "body": [
      ".ifdef ${1:symbol}",
      "    ${2:mov r1, 0}",
      ".endif"
    ],
    "description": "conditional compilation block"
  },
  ".ifelse": {
    "prefix": [
      ".ifelse",
      "ifelse"
    ],
    "body": [
      ".ifdef ${1:symbol}",
      "    ${2:mov r1, 0}",
      ".else",
      "    ${3:mov r1, 1}",
      ".endif"
    ],
    "description": "conditional compilation block with else"
  },
  ".elsif": {
    "prefix": [
      ".elsif",
      "elsif"
    ],
    "body": [
      ".elsif ${1:symbol}"
    ],
    "description": "conditional compilation else-if branch"
  },
  ".macro": {
    "prefix": [
      ".macro",
      "macro"
    ],
    "body": [
      ".macro ${1:name}(${2:rd, value})",
      "    ${3:mov rd, value}",
      ".endm"
    ],
    "description": "parameterized code macro"
  },
  ".include": {
    "prefix": [
      ".include",
      "include"
    ],
    "body": [
      ".include \"${1:file.asm}\""
    ],
    "description": "include another assembly file"
  },
  ".rept": {
    "prefix": [
      ".rept",
      "rept"
    ],
    "body": [
      ".rept ${1:count}",
      "    ${2:mov r1, 0}",
      ".endr"
    ],
    "description": "repeat code block"
  }
}
